{
  "name": "lumina-mdle-dev",
  "version": "1.1.0",
  "description": "MCP server for Moodle development — context, indexes, and AI tooling for Moodle plugin developers",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "moodle",
    "moodle-plugin",
    "plugin-development",
    "moodle-development",
    "ai-tools",
    "ai-context",
    "claude",
    "cursor",
    "vscode"
  ],
  "author": "kaduvelasco",
  "license": "GPL-3.0",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "lumina-mdle-dev": "dist/index.js",
    "lumina-md": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/index.ts --http",
    "inspector": "npx @modelcontextprotocol/inspector dist/index.js",
    "clean": "rm -rf dist",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx/esm --test src/tests/**/*.test.ts",
    "test:watch": "node --import tsx/esm --test --watch src/tests/**/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.10.2",
    "archiver": "^8.0.0",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.8.0",
    "glob": "^13.0.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.3",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "homepage": "https://github.com/kaduvelasco/lumina-mdle-dev#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/kaduvelasco/lumina-mdle-dev.git"
  },
  "bugs": {
    "url": "https://github.com/kaduvelasco/lumina-mdle-dev/issues"
  }
}
